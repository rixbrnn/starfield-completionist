{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rixbrnn/starfield-completionist/blob/main/data/schema/quests.schema.json",
  "title": "Starfield Completionist quest collection",
  "description": "Quests the plugin tracks, the place each one starts, and how completion is detected. See PLAN.md §6.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "requires",
    "quests"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id",
      "description": "Unique collection ID, e.g. \"vanilla.quests\"."
    },
    "title": {
      "type": "string"
    },
    "requires": {
      "description": "Plugins that must be loaded for this collection to apply.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/pluginName"
      },
      "minItems": 1
    },
    "places": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/place"
      }
    },
    "questlines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/questline"
      }
    },
    "quests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/quest"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
    },
    "pluginName": {
      "type": "string",
      "pattern": "^[^|/\\\\]+\\.(esm|esp|esl)$"
    },
    "formKey": {
      "description": "\"Plugin.esm|0x00ABCD\": owning plugin and 6-digit local FormID.",
      "type": "string",
      "pattern": "^[^|/\\\\]+\\.(esm|esp|esl)\\|0x[0-9A-F]{6}$"
    },
    "place": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "system",
            "planet",
            "hub",
            "space",
            "anywhere"
          ],
          "description": "hub = city, settlement or station; space = \"in space\" bucket of a system; anywhere = not tied to a place."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "parent": {
          "$ref": "#/$defs/id"
        },
        "location": {
          "$ref": "#/$defs/formKey",
          "description": "LCTN record used by the Here view."
        }
      }
    },
    "questline": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "main",
            "faction",
            "companion",
            "side"
          ]
        },
        "faction": {
          "type": "string"
        }
      }
    },
    "quest": {
      "type": "object",
      "required": [
        "id",
        "name",
        "form",
        "editorId",
        "type",
        "start",
        "complete"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "form": {
          "$ref": "#/$defs/formKey"
        },
        "editorId": {
          "type": "string",
          "minLength": 1,
          "description": "Editor ID; the plugin resolves quests by it at runtime (FormIDs of non-base plugins depend on load order)."
        },
        "type": {
          "enum": [
            "main",
            "faction",
            "side",
            "companion",
            "misc",
            "activity"
          ]
        },
        "errand": {
          "type": "boolean",
          "description": "Small errand (\"Misc Pointer\" activity), named by its first objective."
        },
        "faction": {
          "type": "string"
        },
        "questline": {
          "type": "object",
          "required": [
            "id",
            "order"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "order": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "start": {
          "type": "object",
          "required": [
            "place",
            "confidence",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "place": {
              "$ref": "#/$defs/id"
            },
            "giver": {
              "type": "string"
            },
            "hint": {
              "type": "string",
              "description": "Written by us. Shown only when spoilers are revealed."
            },
            "confidence": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "source": {
              "enum": [
                "giver",
                "alias",
                "objective",
                "smnode",
                "filter",
                "manual"
              ]
            }
          }
        },
        "visits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "description": "All stage indices; any of them done means the quest has started."
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "description": "Objective indices; a quest is in progress while one of them is displayed and not completed."
        },
        "availableAfter": {
          "type": "array",
          "maxItems": 4,
          "description": "When the quest can be found: once any of these quest stages is done (stage -1: once that quest has started). Absent: can be found any time.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["form", "quest", "stage"],
            "properties": {
              "form": { "type": "string", "description": "Plugin|FormID of the quest whose stage unlocks this one." },
              "quest": { "type": "string", "description": "Its editor ID." },
              "name": { "type": "string", "description": "Its player-facing name, when it has one." },
              "stage": { "type": "integer", "minimum": -1, "maximum": 65535 },
              "group": { "type": "string", "description": "Equivalence group of that quest: any member completing also counts." }
            }
          }
        },
        "steps": {
          "type": "array",
          "description": "Objectives as the mission log shows them, for the menu's expanded quest rows.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text"],
            "properties": {
              "id": { "type": "integer", "minimum": 0, "maximum": 65535, "description": "Objective index." },
              "text": { "type": "string", "description": "Display text, placeholders filled in." },
              "target": { "type": "integer", "minimum": 0, "description": "Alias id of the objective's map target (for Show on map)." },
              "tokens": {
                "type": "array",
                "description": "Placeholders {0}, {1}... in text, filled in game: a location or reference alias, or a global's value; word is shown when that fails.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "word"],
                  "properties": {
                    "kind": { "enum": ["location", "ref", "global"] },
                    "alias": { "type": "integer", "minimum": 0 },
                    "form": { "type": "string" },
                    "word": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "complete": {
          "$ref": "#/$defs/condition"
        },
        "fail": {
          "oneOf": [
            {
              "$ref": "#/$defs/condition"
            },
            {
              "type": "null"
            }
          ]
        },
        "prereqs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "missable": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "after",
                "note"
              ],
              "additionalProperties": false,
              "properties": {
                "after": {
                  "$ref": "#/$defs/id"
                },
                "note": {
                  "type": "string"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "equivalentGroup": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ],
          "description": "Versions of the same quest (e.g. New Game+ variants): completing any member completes the group."
        },
        "hidden": {
          "type": "boolean",
          "description": "Tracked only through its equivalentGroup; not listed or counted."
        },
        "choices": {
          "type": "array",
          "maxItems": 2,
          "description": "Two-sided choice groups this quest belongs to (data/curation.json choiceGroups). Completing a quest on one side locks out unfinished quests on the other.",
          "items": {
            "type": "object",
            "required": [
              "group",
              "side"
            ],
            "additionalProperties": false,
            "properties": {
              "group": {
                "$ref": "#/$defs/id"
              },
              "side": {
                "enum": [
                  "a",
                  "b"
                ]
              }
            }
          }
        },
        "ngPlusOnly": {
          "type": "boolean",
          "description": "Only available after entering Unity (New Game+)."
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "questCompleted"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "stage"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "questStage",
                "questStageRecorded"
              ]
            },
            "stage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "form": {
              "$ref": "#/$defs/formKey",
              "description": "Another quest's stage; defaults to the quest itself."
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "conditions"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "anyOf",
                "allOf"
              ]
            },
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "minItems": 1
            }
          }
        }
      ]
    }
  }
}
